# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local planning notes
.scratch/

# reels 輸出的影片
/renders/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# skills：手寫的 ig-post 進版控，裝來的第三方 skill 由 skills-lock.json 還原
.agents/
.claude/skills/*
!.claude/skills/ig-post/
!.claude/skills/ig-reel/
